# Gmail SMTP configuration
AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_PORT=465
AIRFLOW__SMTP__SMTP_STARTTLS=False
AIRFLOW__SMTP__SMTP_SSL=True

# Replace with your own Gmail account and App Password
AIRFLOW__SMTP__SMTP_USER=your_email@gmail.com
AIRFLOW__SMTP__SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# Email sender and recipient
AIRFLOW__EMAIL__FROM_EMAIL=your_email@gmail.com
AIRFLOW__SMTP__SMTP_MAIL_FROM=your_email@gmail.com
AIRFLOW_ALERT_EMAIL=recipient@example.com

# Custom failure-alert templates
AIRFLOW__EMAIL__SUBJECT_TEMPLATE=/opt/airflow/dags/alert_subject.txt
AIRFLOW__EMAIL__HTML_CONTENT_TEMPLATE=/opt/airflow/dags/alert_body.html